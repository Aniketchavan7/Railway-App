# RailPulse Backend Environment Configuration
PROJECT_NAME="RailPulse"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# Database & Cache
# For PostgreSQL: postgresql+asyncpg://postgres:password@localhost:5432/railpulse
DATABASE_URL="sqlite+aiosqlite:///./railpulse.db"
# For Redis: redis://localhost:6379/0 or rediss://default:token@...upstash.io:6379
REDIS_URL=""

# Upstream Railway Data Providers
RAILWAY_ENGINE_BASE_URL="https://railway-engine.apkscope.workers.dev/v1"
RAILWAY_ENGINE_API_KEY=""

RAILRADAR_BASE_URL="https://api.railradar.in/v1"
RAILRADAR_API_KEY=""

# Offline Simulator (Default: true for demo mode; false in production)
ENABLE_SIMULATOR=true

# xKiro AI API Configuration (100% Free models available on api.xkiro.com/v1)
# Free options: mistralai/mistral-large-2512, mistralai/mistral-small-2603, qwen/qwen3.7-flash:free, cohere/command-a-plus
XKIRO_BASE_URL="https://api.xkiro.com/v1"
XKIRO_API_KEY=""
XKIRO_MODEL="mistralai/mistral-small-2603"

# Security
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"
